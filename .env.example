# Optional local overrides. tools/deploy.py reads these values from Google
# Secret Manager by default, so most deployments do not need a .env file.
WATTTIME_USERNAME=
WATTTIME_PASSWORD=
# Only if you set a password on the plug:
SHELLY_PASSWORD=
# Plug key for the solar-edge service. Leave empty to read it from Secret
# Manager with your gcloud login.
PLUG_KEY=
