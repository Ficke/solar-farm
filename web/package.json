{
  "name": "solar-farm-web",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "openapi-typescript openapi.json -o src/lib/schema.d.ts --silent",
    "dev": "bun run gen && vite",
    "build": "bun run gen && vite build",
    "check": "bun run gen && svelte-check --tsconfig ./tsconfig.json && biome check .",
    "fmt": "biome check --write ."
  },
  "dependencies": {
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.0",
    "vite": "^8.3.2"
  }
}
